# 复制为 .env，仅用于本机开发。不要提交真实密钥。
DATABASE_URL="postgresql://YOUR_LOCAL_USER@localhost:5432/badminton_tournament_dev?schema=public"
BETTER_AUTH_SECRET="请替换为至少32字符的随机值"
BETTER_AUTH_URL="http://127.0.0.1:3000"
APP_ENV="development"
ENABLE_PUBLIC_UI_PREVIEW="false"

# 示例账号只允许由单独、未提交的 .env.seed 提供。
# 生产环境若出现这些配置，应用会拒绝启动。
ALLOW_DEMO_ACCOUNTS="false"
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
DEMO_REFEREE_EMAIL=""
DEMO_REFEREE_PASSWORD=""
DEMO_PARTICIPANT_EMAIL=""
DEMO_PARTICIPANT_PASSWORD=""

# 阶段 8（均可省略）：写请求额外信任的来源（逗号分隔的完整来源，如经反向代理的正式域名）；
# BETTER_AUTH_URL 与请求自身的 Host 已自动信任。
# APP_TRUSTED_ORIGINS=
# 公开查询按来源限流（每分钟次数，0 = 关闭，只用于本机基准）。进程内计数，正式部署应在反向代理上限流。
# PUBLIC_RATE_LIMIT_PER_MINUTE=600
# PUBLIC_PAGE_RATE_LIMIT_PER_MINUTE=3000
