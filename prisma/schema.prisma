generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// 平台级角色只决定「能否新建赛事」。赛事内的一切权限仍由赛事范围的 RoleAssignment 决定，
// SYSTEM_ADMIN 不会因此自动获得任何既有赛事的访问权。
enum SystemRole {
  USER
  SYSTEM_ADMIN
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// 发布可见性（TournamentStatus）与赛事生命周期（TournamentPhase）是两个维度，不得合并。
// phase 由组织者显式推进并审计，不按服务器当前时间推导。
enum TournamentPhase {
  PREPARING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  RUNNING
  FINISHED
}

// 参赛者姓名与代表队的公开范围由组织者决定，默认只公开编号。
enum NamePublicationPolicy {
  CODES_ONLY
  DISPLAY_NAMES
}

// 裁判执裁方式：SHARED_ACCOUNT 为全体裁判共用本赛事的裁判员账号、可执裁任意一场；
// PER_MATCH 为按赛程逐场指派主裁判，只能执裁指派给自己的比赛。
enum RefereeMode {
  SHARED_ACCOUNT
  PER_MATCH
}

// TEAM 是团体赛（学院对抗）：报名单位是一支队伍，每场对抗由若干单打/双打「小场」组成。
enum CompetitionKind {
  MS
  WS
  MD
  WD
  XD
  CUSTOM
  TEAM
}

enum EntryType {
  SINGLES
  DOUBLES
  TEAM
}

// 性别只用于核对团体名单能否组成男/女/混合小场，由负责人明确填写，不从姓名或证件推断。
enum Gender {
  MALE
  FEMALE
}

enum StageType {
  ROUND_ROBIN
  KNOCKOUT
}

enum TournamentRole {
  ADMIN
  ORGANIZER
  REFEREE
  CHIEF_REFEREE
}

// 报名只是「申请」；只有 APPROVED 才会生成 Entry，进入后续编排。
enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum RegistrationSource {
  MANUAL
  IMPORT
  INVITE
  TEAM_MANAGER
}

// 抽签：草稿可多次生成/调签；正式发布后生成阶段、小组、对阵与比赛并冻结报名单位。
// 每个项目同时最多一个草稿、一个已发布版本；被替代或撤销的版本保留备查。
enum DrawStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  REVOKED
}

enum DrawFormat {
  ROUND_ROBIN
  GROUPS_KNOCKOUT
  KNOCKOUT
}

enum FixtureKind {
  GROUP
  KNOCKOUT
  THIRD_PLACE
}

// 对阵一侧的来源：确定的报名单位、某组第几名、某场对阵的胜者/负者。未决来源不虚构参赛者。
enum FixtureSourceType {
  ENTRY
  GROUP_RANK
  FIXTURE_WINNER
  FIXTURE_LOSER
}

// 团体对抗的一侧（与比赛计分的 A/B 同义）。
enum MatchSide {
  A
  B
}

// 出场名单的提交途径：队伍负责人本人，或赛事管理员代交。
enum LineupSource {
  TEAM_MANAGER
  ADMIN
}

enum OfficialRole {
  MAIN_REFEREE
}

enum MatchLifecycleStatus {
  SCHEDULED
  READY
  IN_PROGRESS
  SUSPENDED
  ENDED_PENDING_SUBMISSION
  SUBMITTED
}

enum MatchOutcomeType {
  NORMAL
  WO
  RET
  DSQ
  ABANDONED
  BYE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  LOCKED
  DISPUTED
  SUPERSEDED
}

enum ScoringSessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ResultRevisionStatus {
  PENDING
  RETURNED
  LOCKED
  SUPERSEDED
}

// 结果来源：LIVE 是裁判台逐分记分（关联记分事件与冻结规则）；
// RESULT_ONLY 是管理员补录的逐局结果（例如历史或线下纸质记分），只有结果，不伪造回合与发接发过程。
enum ResultSource {
  LIVE
  RESULT_ONLY
}

// 已确认结果的更正被后续已开始的比赛阻止时，裁判长登记的人工处置决定。
// 系统不会因此自动改写任何比赛；「线下处置」须由裁判长在现场决定暂停、取消或重赛后另行执行。
enum ResultDispositionDecision {
  MAINTAIN
  OFFLINE_RULING
}

// 阶段 7：导出文件种类。内部报名名单含学号与联系方式，只供赛事管理员/编排员；其余是对外版本。
enum ReportKind {
  REGISTRATIONS_INTERNAL
  DATA_WORKBOOK
  BOOKLET_PDF
}

// 草稿可带暂定结果并醒目标记；正式版只引用经裁判长复核锁定的结果与已发布的名次榜单。
enum ReportEdition {
  DRAFT
  OFFICIAL
}

model User {
  id                         String                    @id @default(uuid()) @db.Uuid
  name                       String
  email                      String                    @unique
  // Better Auth username 插件：可选的登录用户名（小写归一），与邮箱二选一登录。
  username                   String?                   @unique
  displayUsername            String?
  emailVerified              Boolean                   @default(false)
  image                      String?
  status                     UserStatus                @default(ACTIVE)
  systemRole                 SystemRole                @default(USER)
  // 由赛事管理员开通的队伍负责人账号：初始口令只显示一次，首次登录必须修改。
  mustChangePassword         Boolean                   @default(false)
  provisionedForTournamentId String?                   @db.Uuid
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  sessions                   Session[]
  accounts                   Account[]
  roleAssignments            RoleAssignment[]
  officialAssignments        OfficialAssignment[]
  scoringSessions            ScoringSession[]
  matchEvents                MatchEvent[]              @relation("MatchEventActor")
  resultRevisions            ResultRevision[]          @relation("ResultRevisionActor")
  reviewedRevisions          ResultRevision[]          @relation("ResultRevisionReviewer")
  auditLogs                  AuditLog[]                @relation("AuditActor")
  submittedRegistrations     Registration[]            @relation("RegistrationSubmitter")
  reviewedRegistrations      Registration[]            @relation("RegistrationReviewer")
  createdInvites             RegistrationInvite[]
  importBatches              RegistrationImportBatch[]
  provisionedForTournament   Tournament?               @relation("ProvisionedUsers", fields: [provisionedForTournamentId], references: [id], onDelete: SetNull)
  teamManagerships           TeamManager[]             @relation("TeamManagerUser")
  createdTeamManagers        TeamManager[]             @relation("TeamManagerCreator")
  createdDraws               Draw[]                    @relation("DrawCreator")
  publishedDraws             Draw[]                    @relation("DrawPublisher")
  revokedDraws               Draw[]                    @relation("DrawRevoker")
  submittedLineups           FixtureLineup[]           @relation("LineupSubmitter")
  confirmedGroupRankings     Group[]                   @relation("GroupRankingConfirmer")
  draftScheduleSlots         ScheduleSlot[]            @relation("ScheduleSlotReferee")
  editedScheduleSlots        ScheduleSlot[]            @relation("ScheduleSlotEditor")
  schedulePublications       SchedulePublication[]     @relation("SchedulePublisher")
  rankingExclusions          RankingExclusion[]        @relation("RankingExclusionDecider")
  standingsPublications      StandingsPublication[]    @relation("StandingsPublisher")
  resultDispositions         ResultDisposition[]       @relation("ResultDispositionDecider")
  reportExports              ReportExport[]            @relation("ReportExportCreator")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Tournament {
  id                    String                    @id @default(uuid()) @db.Uuid
  slug                  String                    @unique
  name                  String
  subtitle              String?
  organizer             String?
  venue                 String?
  summary               String?
  startDate             DateTime?                 @db.Date
  endDate               DateTime?                 @db.Date
  posterPath            String?
  posterAlt             String?
  timezone              String                    @default("Asia/Shanghai")
  status                TournamentStatus          @default(DRAFT)
  phase                 TournamentPhase           @default(PREPARING)
  namePolicy            NamePublicationPolicy     @default(CODES_ONLY)
  refereeMode           RefereeMode               @default(PER_MATCH)
  publishedAt           DateTime?
  regulations           String?
  registrationOpensAt   DateTime?
  registrationClosesAt  DateTime?
  nextParticipantSeq    Int                       @default(1)
  defaultRuleRevisionId String?                   @db.Uuid
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  defaultRuleRevision   RuleProfileRevision?      @relation("TournamentDefaultRule", fields: [defaultRuleRevisionId], references: [id], onDelete: SetNull)
  competitions          Competition[]
  courts                Court[]
  ruleProfiles          RuleProfile[]
  roleAssignments       RoleAssignment[]
  auditLogs             AuditLog[]
  participants          Participant[]
  registrations         Registration[]
  registrationInvites   RegistrationInvite[]
  importBatches         RegistrationImportBatch[]
  teams                 Team[]
  teamManagers          TeamManager[]
  provisionedUsers      User[]                    @relation("ProvisionedUsers")
  scheduleConfig        ScheduleConfig?
  scheduleDays          ScheduleDay[]
  scheduleSlots         ScheduleSlot[]
  schedulePublications  SchedulePublication[]
  reportExports         ReportExport[]

  @@map("tournaments")
}

model Competition {
  id                    String                 @id @default(uuid()) @db.Uuid
  tournamentId          String                 @db.Uuid
  code                  String
  name                  String
  kind                  CompetitionKind
  entryType             EntryType
  ruleProfileRevisionId String?                @db.Uuid
  nextEntrySeq          Int                    @default(1)
  // 仅团体项目：每场对抗的小场顺序与名单人数要求。非团体项目必须为空（迁移中的 CHECK 兜底）。
  teamRubbers           CompetitionKind[]      @default([])
  teamRosterMin         Int?
  teamRosterMax         Int?
  teamMinMale           Int?
  teamMinFemale         Int?
  // 仅团体项目：同一队员在一场对抗里最多上几个小场（按性别）；为空表示不设上限。
  teamMaxRubbersMale    Int?
  teamMaxRubbersFemale  Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tournament            Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  ruleProfileRevision   RuleProfileRevision?   @relation("CompetitionRule", fields: [ruleProfileRevisionId], references: [id], onDelete: SetNull)
  stages                Stage[]
  entries               Entry[]
  entryMembers          EntryMember[]
  registrations         Registration[]
  draws                 Draw[]
  fixtures              Fixture[]
  standingsPublications StandingsPublication[]

  @@unique([tournamentId, code])
  @@index([tournamentId])
  @@map("competitions")
}

// 参赛人员按赛事隔离：同一个真实的人在两个赛事里是两条记录，互不泄露。
// 姓名不是身份；学号只在赛事内唯一，且与联系方式一样只供内部审核，不进入任何公开白名单。
model Participant {
  id                  String               @id @default(uuid()) @db.Uuid
  tournamentId        String               @db.Uuid
  publicCode          String
  displayName         String
  teamName            String?
  studentId           String?
  contact             String?
  gender              Gender?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tournament          Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  memberships         EntryMember[]
  registrationMembers RegistrationMember[]
  matchAppearances    MatchPlayer[]

  @@unique([tournamentId, publicCode])
  @@unique([tournamentId, studentId])
  @@index([tournamentId, displayName])
  @@map("participants")
}

// 抽签发布时设置 frozenAt：此后不能通过、撤回或换人。团体报名单位额外挂在一个 Team 上。
model Entry {
  id            String             @id @default(uuid()) @db.Uuid
  competitionId String             @db.Uuid
  code          String
  displayName   String
  entryType     EntryType
  teamId        String?            @db.Uuid
  frozenAt      DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  competition   Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team          Team?              @relation(fields: [teamId], references: [id], onDelete: NoAction)
  members       EntryMember[]
  matchesAsA    Match[]            @relation("MatchSideA")
  matchesAsB    Match[]            @relation("MatchSideB")
  fixturesAsA   Fixture[]          @relation("FixtureSideAEntry")
  fixturesAsB   Fixture[]          @relation("FixtureSideBEntry")
  fixturesWon   Fixture[]          @relation("FixtureWinner")
  lineups       FixtureLineup[]
  matchPlayers  MatchPlayer[]
  registration  Registration?
  exclusions    RankingExclusion[]

  @@unique([competitionId, code])
  @@unique([competitionId, teamId])
  @@index([competitionId])
  @@map("entries")
}

// competitionId 是 entries.competitionId 的冗余副本（由迁移中的触发器保证一致），
// 只为让数据库用唯一索引兜底「同一人在同一项目只能出现在一个报名单位里」。
model EntryMember {
  id            String            @id @default(uuid()) @db.Uuid
  entryId       String            @db.Uuid
  competitionId String            @db.Uuid
  participantId String            @db.Uuid
  slot          Int
  // 仅团体报名单位：审核通过时从名单复制的报项，个人项目必须为空（触发器兜底）。
  rubberKinds   CompetitionKind[] @default([])
  entry         Entry             @relation(fields: [entryId], references: [id], onDelete: Cascade)
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant   Participant       @relation(fields: [participantId], references: [id], onDelete: NoAction)

  @@unique([entryId, participantId])
  @@unique([entryId, slot])
  @@unique([competitionId, participantId])
  @@index([participantId])
  @@map("entry_members")
}

model Registration {
  id                   String                   @id @default(uuid()) @db.Uuid
  tournamentId         String                   @db.Uuid
  competitionId        String                   @db.Uuid
  referenceCode        String                   @unique
  status               RegistrationStatus       @default(PENDING)
  source               RegistrationSource
  teamId               String?                  @db.Uuid
  version              Int                      @default(0)
  dedupeKey            String?
  note                 String?
  reviewReason         String?
  entryId              String?                  @unique @db.Uuid
  inviteId             String?                  @db.Uuid
  importBatchId        String?                  @db.Uuid
  importRowNumber      Int?
  submittedByUserId    String?                  @db.Uuid
  submitterFingerprint String?
  reviewedByUserId     String?                  @db.Uuid
  reviewedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  tournament           Tournament               @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  competition          Competition              @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  // NoAction（语句末检查）：撤回时必须先解除关联再删 Entry；整赛事级联删除仍可在同一语句内完成。
  entry                Entry?                   @relation(fields: [entryId], references: [id], onDelete: NoAction)
  invite               RegistrationInvite?      @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  importBatch          RegistrationImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  team                 Team?                    @relation(fields: [teamId], references: [id], onDelete: NoAction)
  submittedBy          User?                    @relation("RegistrationSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy           User?                    @relation("RegistrationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  members              RegistrationMember[]

  @@index([tournamentId, status, createdAt])
  @@index([competitionId, status])
  @@index([inviteId, createdAt])
  @@map("registrations")
}

// 报名时提交的人员信息原样保留，便于审核留痕；审核通过时才解析为 Participant。
model RegistrationMember {
  id             String            @id @default(uuid()) @db.Uuid
  registrationId String            @db.Uuid
  slot           Int
  displayName    String
  studentId      String?
  teamName       String?
  contact        String?
  gender         Gender?
  // 仅团体名单：该队员报了哪些小场（男单/女单/男双/女双/混双），排出场名单时只能从报了该项的队员里选。
  rubberKinds    CompetitionKind[] @default([])
  participantId  String?           @db.Uuid
  registration   Registration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  participant    Participant?      @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([registrationId, slot])
  @@index([participantId])
  @@map("registration_members")
}

// 匿名邀请链接：只保存令牌摘要，明文令牌仅在创建时返回一次。
model RegistrationInvite {
  id              String         @id @default(uuid()) @db.Uuid
  tournamentId    String         @db.Uuid
  label           String
  tokenHash       String         @unique
  tokenHint       String
  expiresAt       DateTime
  maxSubmissions  Int
  submissionCount Int            @default(0)
  revokedAt       DateTime?
  createdByUserId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tournament      Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  registrations   Registration[]

  @@index([tournamentId])
  @@map("registration_invites")
}

// 导入批次只记录内容摘要与计数，不保存上传原文件。
model RegistrationImportBatch {
  id              String         @id @default(uuid()) @db.Uuid
  tournamentId    String         @db.Uuid
  contentHash     String
  rowCount        Int
  createdCount    Int
  skippedCount    Int
  createdByUserId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  tournament      Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  registrations   Registration[]

  @@unique([tournamentId, contentHash])
  @@map("registration_import_batches")
}

model Stage {
  id                    String               @id @default(uuid()) @db.Uuid
  competitionId         String               @db.Uuid
  code                  String
  name                  String
  type                  StageType
  order                 Int
  ruleProfileRevisionId String?              @db.Uuid
  drawId                String?              @db.Uuid
  frozenAt              DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  competition           Competition          @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  ruleProfileRevision   RuleProfileRevision? @relation("StageRule", fields: [ruleProfileRevisionId], references: [id], onDelete: SetNull)
  draw                  Draw?                @relation(fields: [drawId], references: [id], onDelete: NoAction)
  groups                Group[]
  matches               Match[]
  fixtures              Fixture[]

  @@unique([competitionId, code])
  @@map("stages")
}

model Group {
  id                       String             @id @default(uuid()) @db.Uuid
  stageId                  String             @db.Uuid
  code                     String
  name                     String
  // 小组名次经裁判长确认后固定（含无法区分时的抽签顺序），并据此回填淘汰签位。
  ranking                  Json?
  rankingConfirmedAt       DateTime?
  rankingConfirmedByUserId String?            @db.Uuid
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  stage                    Stage              @relation(fields: [stageId], references: [id], onDelete: Cascade)
  rankingConfirmedBy       User?              @relation("GroupRankingConfirmer", fields: [rankingConfirmedByUserId], references: [id], onDelete: SetNull)
  matches                  Match[]
  fixtures                 Fixture[]          @relation("FixtureGroup")
  sourceForSideA           Fixture[]          @relation("FixtureSideAGroup")
  sourceForSideB           Fixture[]          @relation("FixtureSideBGroup")
  exclusions               RankingExclusion[]

  @@unique([stageId, code])
  @@map("competition_groups")
}

// 场地关闭（active=false）后不能再排新比赛；已排在它上面的比赛在赛程检查中是硬冲突。
model Court {
  id            String         @id @default(uuid()) @db.Uuid
  tournamentId  String         @db.Uuid
  code          String
  name          String
  active        Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tournament    Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches       Match[]
  scheduleSlots ScheduleSlot[]

  @@unique([tournamentId, code])
  @@map("courts")
}

model RuleProfile {
  id           String                @id @default(uuid()) @db.Uuid
  tournamentId String                @db.Uuid
  key          String
  name         String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tournament   Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  revisions    RuleProfileRevision[]

  @@unique([tournamentId, key])
  @@map("rule_profiles")
}

model RuleProfileRevision {
  id                    String              @id @default(uuid()) @db.Uuid
  ruleProfileId         String              @db.Uuid
  revision              Int
  sourceLabel           String
  sourceVersion         String
  config                Json
  configHash            String
  effectiveFrom         DateTime?
  adoptedAt             DateTime?
  frozenAt              DateTime?
  createdAt             DateTime            @default(now())
  ruleProfile           RuleProfile         @relation(fields: [ruleProfileId], references: [id], onDelete: Restrict)
  defaultForTournaments Tournament[]        @relation("TournamentDefaultRule")
  competitions          Competition[]       @relation("CompetitionRule")
  stages                Stage[]             @relation("StageRule")
  matchSnapshots        MatchRuleSnapshot[]

  @@unique([ruleProfileId, revision])
  @@map("rule_profile_revisions")
}

model Match {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique
  stageId             String               @db.Uuid
  groupId             String?              @db.Uuid
  courtId             String?              @db.Uuid
  sideAEntryId        String?              @db.Uuid
  sideBEntryId        String?              @db.Uuid
  // 抽签生成的比赛挂在对阵上；团体对抗的每个小场是一场独立比赛，按 rubberOrder 排序。
  fixtureId           String?              @db.Uuid
  rubberKind          CompetitionKind?
  rubberOrder         Int?
  // 淘汰赛团体对抗胜负已定后，尚未开始的小场不再进行（不是弃权、不记比分）。
  notPlayedAt         DateTime?
  lifecycleStatus     MatchLifecycleStatus @default(SCHEDULED)
  outcomeType         MatchOutcomeType?
  verificationStatus  VerificationStatus   @default(UNVERIFIED)
  resultSource        ResultSource         @default(LIVE)
  // 已发布赛程的计划开始/结束（结束 = 开始 + 预计时长，不是保证时长）；实际开始/结束另记。
  scheduledAt         DateTime?
  scheduledEndAt      DateTime?
  // 计划时间是「接上一场之后」推算的预计值，而不是固定开赛时刻。
  scheduleEstimated   Boolean              @default(false)
  startedAt           DateTime?
  endedAt             DateTime?
  publishedAt         DateTime?
  version             Int                  @default(0)
  controlGeneration   Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  stage               Stage                @relation(fields: [stageId], references: [id], onDelete: Restrict)
  group               Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  court               Court?               @relation(fields: [courtId], references: [id], onDelete: SetNull)
  sideAEntry          Entry?               @relation("MatchSideA", fields: [sideAEntryId], references: [id], onDelete: Restrict)
  sideBEntry          Entry?               @relation("MatchSideB", fields: [sideBEntryId], references: [id], onDelete: Restrict)
  fixture             Fixture?             @relation(fields: [fixtureId], references: [id], onDelete: Restrict)
  games               Game[]
  ruleSnapshot        MatchRuleSnapshot?
  events              MatchEvent[]
  snapshot            MatchSnapshot?
  scoringSessions     ScoringSession[]
  resultRevisions     ResultRevision[]
  officialAssignments OfficialAssignment[]
  players             MatchPlayer[]
  scheduleSlot        ScheduleSlot?
  resultDispositions  ResultDisposition[]

  @@unique([fixtureId, rubberOrder])
  @@index([stageId])
  @@index([fixtureId])
  @@index([courtId, scheduledAt])
  @@index([publishedAt, scheduledAt])
  @@map("matches")
}

model MatchRuleSnapshot {
  id                    String              @id @default(uuid()) @db.Uuid
  matchId               String              @unique @db.Uuid
  ruleProfileRevisionId String              @db.Uuid
  config                Json
  configHash            String
  sourceChain           Json
  createdAt             DateTime            @default(now())
  match                 Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  ruleProfileRevision   RuleProfileRevision @relation(fields: [ruleProfileRevisionId], references: [id], onDelete: Restrict)

  @@map("match_rule_snapshots")
}

model Game {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @db.Uuid
  number    Int
  scoreA    Int      @default(0)
  scoreB    Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, number])
  @@map("games")
}

model MatchEvent {
  id                 String          @id @default(uuid()) @db.Uuid
  matchId            String          @db.Uuid
  version            Int
  commandId          String?         @unique @db.Uuid
  domainEventId      String?
  expectedVersion    Int?
  commandFingerprint String?
  type               String
  payload            Json
  stateBefore        Json?
  stateAfter         Json?
  stateBeforeHash    String?
  stateAfterHash     String?
  metadata           Json?
  response           Json?
  engineVersion      Int             @default(1)
  actorUserId        String?         @db.Uuid
  actorRole          TournamentRole?
  scoringSessionId   String?         @db.Uuid
  occurredAt         DateTime        @default(now())
  match              Match           @relation(fields: [matchId], references: [id], onDelete: Restrict)
  actor              User?           @relation("MatchEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  scoringSession     ScoringSession? @relation(fields: [scoringSessionId], references: [id], onDelete: SetNull)

  @@unique([matchId, version])
  @@index([scoringSessionId])
  @@map("match_events")
}

model MatchSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  matchId          String   @unique @db.Uuid
  version          Int      @default(0)
  engineVersion    Int      @default(1)
  initialState     Json
  initialStateHash String
  state            Json
  stateHash        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("match_snapshots")
}

model ScoringSession {
  id                 String               @id @default(uuid()) @db.Uuid
  matchId            String               @db.Uuid
  userId             String               @db.Uuid
  deviceSessionId    String
  tokenHash          String               @unique
  takeoverGeneration Int                  @default(1)
  actingRole         TournamentRole       @default(REFEREE)
  status             ScoringSessionStatus @default(ACTIVE)
  expiresAt          DateTime
  lastHeartbeatAt    DateTime             @default(now())
  revokedAt          DateTime?
  revokedReason      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  match              Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  matchEvents        MatchEvent[]

  @@index([matchId, status])
  @@map("scoring_sessions")
}

model ResultRevision {
  id               String               @id @default(uuid()) @db.Uuid
  matchId          String               @db.Uuid
  revision         Int
  status           ResultRevisionStatus @default(PENDING)
  source           ResultSource         @default(LIVE)
  result           Json
  reason           String?
  actorUserId      String?              @db.Uuid
  submittedRole    TournamentRole?
  reviewedByUserId String?              @db.Uuid
  reviewedRole     TournamentRole?
  reviewedAt       DateTime?
  returnedAt       DateTime?
  createdAt        DateTime             @default(now())
  match            Match                @relation(fields: [matchId], references: [id], onDelete: Restrict)
  actor            User?                @relation("ResultRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reviewedBy       User?                @relation("ResultRevisionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([matchId, revision])
  @@index([reviewedByUserId])
  @@map("result_revisions")
}

model RoleAssignment {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  tournamentId String         @db.Uuid
  role         TournamentRole
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId, role])
  @@index([tournamentId, role])
  @@map("role_assignments")
}

model OfficialAssignment {
  id        String       @id @default(uuid()) @db.Uuid
  matchId   String       @db.Uuid
  userId    String       @db.Uuid
  role      OfficialRole @default(MAIN_REFEREE)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  match     Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId, role])
  @@index([userId, active])
  @@map("official_assignments")
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  tournamentId String?     @db.Uuid
  actorUserId  String?     @db.Uuid
  action       String
  targetType   String
  targetId     String
  outcome      String
  metadata     Json?
  occurredAt   DateTime    @default(now())
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  actor        User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tournamentId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_logs")
}

// 代表队（校内联赛中通常是一个学院）。按赛事隔离；团体报名单位挂在队伍上。
model Team {
  id            String         @id @default(uuid()) @db.Uuid
  tournamentId  String         @db.Uuid
  code          String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tournament    Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  managers      TeamManager[]
  registrations Registration[]
  entries       Entry[]

  @@unique([tournamentId, code])
  @@unique([tournamentId, name])
  @@map("teams")
}

// 队伍负责人：只能查看和提交本队名单，不获得任何赛事管理、执裁或审核权限。
model TeamManager {
  id              String     @id @default(uuid()) @db.Uuid
  teamId          String     @db.Uuid
  tournamentId    String     @db.Uuid
  userId          String     @db.Uuid
  createdByUserId String?    @db.Uuid
  createdAt       DateTime   @default(now())
  team            Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user            User       @relation("TeamManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation("TeamManagerCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([teamId, userId])
  @@index([userId, tournamentId])
  @@map("team_managers")
}

// 一次抽签：保存输入名单快照、设置、随机种子、算法版本、手动调签与结果，足以完整复现。
model Draw {
  id                String      @id @default(uuid()) @db.Uuid
  competitionId     String      @db.Uuid
  version           Int
  status            DrawStatus  @default(DRAFT)
  format            DrawFormat
  algorithmVersion  String
  randomSeed        String
  inputHash         String
  input             Json
  settings          Json
  adjustments       Json
  result            Json
  conflictCount     Int
  createdByUserId   String?     @db.Uuid
  createdAt         DateTime    @default(now())
  publishedByUserId String?     @db.Uuid
  publishedAt       DateTime?
  revokedByUserId   String?     @db.Uuid
  revokedAt         DateTime?
  revokeReason      String?
  competition       Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  createdBy         User?       @relation("DrawCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedBy       User?       @relation("DrawPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  revokedBy         User?       @relation("DrawRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  stages            Stage[]
  fixtures          Fixture[]

  @@unique([competitionId, version])
  @@map("draws")
}

// 对阵：个人项目对应 1 场比赛，团体项目对应 1 场学院对抗（若干小场比赛）。
// 两侧来源由 CHECK 与触发器保证自洽、同项目、且只引用更早的轮次（无环）。
model Fixture {
  id                String            @id @default(uuid()) @db.Uuid
  drawId            String            @db.Uuid
  competitionId     String            @db.Uuid
  stageId           String            @db.Uuid
  groupId           String?           @db.Uuid
  code              String
  kind              FixtureKind
  round             Int
  sequence          Int
  label             String
  sideASource       FixtureSourceType
  sideAEntryId      String?           @db.Uuid
  sideAGroupId      String?           @db.Uuid
  sideARank         Int?
  sideAFixtureId    String?           @db.Uuid
  sideBSource       FixtureSourceType
  sideBEntryId      String?           @db.Uuid
  sideBGroupId      String?           @db.Uuid
  sideBRank         Int?
  sideBFixtureId    String?           @db.Uuid
  // 团体对抗：双方出场名单都交齐的时刻（此前双方互相看不到，此后锁定）。
  lineupsRevealedAt DateTime?
  // 对抗胜负：由已锁定的小场结果推导，随结果重开自动撤回。
  winnerEntryId     String?           @db.Uuid
  decidedAt         DateTime?
  createdAt         DateTime          @default(now())
  draw              Draw              @relation(fields: [drawId], references: [id], onDelete: Cascade)
  competition       Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  stage             Stage             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  group             Group?            @relation("FixtureGroup", fields: [groupId], references: [id], onDelete: Cascade)
  sideAEntry        Entry?            @relation("FixtureSideAEntry", fields: [sideAEntryId], references: [id], onDelete: NoAction)
  sideBEntry        Entry?            @relation("FixtureSideBEntry", fields: [sideBEntryId], references: [id], onDelete: NoAction)
  sideAGroup        Group?            @relation("FixtureSideAGroup", fields: [sideAGroupId], references: [id], onDelete: NoAction)
  sideBGroup        Group?            @relation("FixtureSideBGroup", fields: [sideBGroupId], references: [id], onDelete: NoAction)
  sideAFixture      Fixture?          @relation("FixtureSideAFixture", fields: [sideAFixtureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sideBFixture      Fixture?          @relation("FixtureSideBFixture", fields: [sideBFixtureId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feedsSideA        Fixture[]         @relation("FixtureSideAFixture")
  feedsSideB        Fixture[]         @relation("FixtureSideBFixture")
  winnerEntry       Entry?            @relation("FixtureWinner", fields: [winnerEntryId], references: [id], onDelete: NoAction)
  matches           Match[]
  lineups           FixtureLineup[]

  @@unique([competitionId, code])
  @@index([drawId])
  @@index([stageId])
  @@map("fixtures")
}

// 一支队伍在一场团体对抗里的出场名单（表头）。双方盲交：交齐前只有本方看得到。
model FixtureLineup {
  id                String       @id @default(uuid()) @db.Uuid
  fixtureId         String       @db.Uuid
  side              MatchSide
  entryId           String       @db.Uuid
  source            LineupSource
  // 截止时间（首个小场计划开始前若干分钟）之后由管理员代交。
  submittedLate     Boolean      @default(false)
  version           Int          @default(1)
  submittedByUserId String?      @db.Uuid
  submittedAt       DateTime     @default(now())
  fixture           Fixture      @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  // 名单依附于报名单位（抽签发布后报名单位冻结，应用内不会删除）；整赛事删除时随之级联。
  entry             Entry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  submittedBy       User?        @relation("LineupSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@unique([fixtureId, side])
  @@map("fixture_lineups")
}

// 团体小场的上场队员：一侧 1 人（单打）或 2 人（双打），必须是该侧队伍名单里报了该项的队员。
model MatchPlayer {
  id            String      @id @default(uuid()) @db.Uuid
  matchId       String      @db.Uuid
  side          MatchSide
  slot          Int
  entryId       String      @db.Uuid
  participantId String      @db.Uuid
  createdAt     DateTime    @default(now())
  match         Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  entry         Entry       @relation(fields: [entryId], references: [id], onDelete: NoAction)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: NoAction)

  @@unique([matchId, side, slot])
  @@unique([matchId, participantId])
  @@index([participantId])
  @@map("match_players")
}

// ---------------------------------------------------------------------------
// 阶段 4-C：赛程与裁判排班
// ---------------------------------------------------------------------------

// 每个赛事一份赛程设置。时长是预计值，只用于排程与推算延误，不是保证时长。
model ScheduleConfig {
  tournamentId          String     @id @db.Uuid
  matchMinutes          Int        @default(30)
  rubberMinutes         Int        @default(25)
  changeoverMinutes     Int        @default(5)
  // 淘汰赛一场团体对抗同时占用几块场地（小组赛固定一组一块场地）。
  knockoutTieCourts     Int        @default(2)
  lineupDeadlineMinutes Int        @default(30)
  updatedAt             DateTime   @updatedAt
  tournament            Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@map("schedule_configs")
}

// 比赛日与开放时段（赛事时区下当天的第几分钟），自动建议只在这些时段内排比赛。
model ScheduleDay {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  day          DateTime   @db.Date
  startMinute  Int
  endMinute    Int
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, day])
  @@map("schedule_days")
}

// 草稿赛程：一行覆盖一场比赛的已发布安排；没有草稿行的比赛沿用已发布值。发布后清空。
model ScheduleSlot {
  id              String     @id @default(uuid()) @db.Uuid
  tournamentId    String     @db.Uuid
  matchId         String     @unique @db.Uuid
  courtId         String?    @db.Uuid
  startsAt        DateTime?
  durationMinutes Int
  estimated       Boolean    @default(false)
  refereeUserId   String?    @db.Uuid
  updatedByUserId String?    @db.Uuid
  updatedAt       DateTime   @updatedAt
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match           Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  court           Court?     @relation(fields: [courtId], references: [id], onDelete: NoAction)
  referee         User?      @relation("ScheduleSlotReferee", fields: [refereeUserId], references: [id], onDelete: SetNull)
  updatedBy       User?      @relation("ScheduleSlotEditor", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@map("schedule_slots")
}

// 赛程发布版本：保存发布时的完整安排、与上一版的差异，以及发布者确认过的警告。
model SchedulePublication {
  id                String     @id @default(uuid()) @db.Uuid
  tournamentId      String     @db.Uuid
  version           Int
  publishedAt       DateTime   @default(now())
  publishedByUserId String?    @db.Uuid
  matchCount        Int
  snapshot          Json
  changes           Json
  warnings          Json
  note              String?
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  publishedBy       User?      @relation("SchedulePublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, version])
  @@map("schedule_publications")
}

// ---------------------------------------------------------------------------
// 阶段 6（prompt-kit 07）：成绩、名次与晋级
// ---------------------------------------------------------------------------

// 裁判长的处理决定：某报名单位因弃权/退赛/取消资格等不能完成本组比赛，
// 按「排除该单位及其全部对阵贡献」处理。原比赛、比分与审计历史保留，只是不进入名次统计。
model RankingExclusion {
  id              String   @id @default(uuid()) @db.Uuid
  groupId         String   @db.Uuid
  entryId         String   @db.Uuid
  reason          String
  decidedByUserId String?  @db.Uuid
  decidedAt       DateTime @default(now())
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  entry           Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  decidedBy       User?    @relation("RankingExclusionDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([groupId, entryId])
  @@map("ranking_exclusions")
}

// 名次榜单发布版本：保存发布时的完整名次快照与内容摘要。
// 之后结果被更正、名次被撤回时，当前内容摘要与最新发布不同，界面标记「需重新发布」；历史版本全部保留。
model StandingsPublication {
  id                String      @id @default(uuid()) @db.Uuid
  competitionId     String      @db.Uuid
  version           Int
  contentHash       String
  snapshot          Json
  note              String?
  publishedByUserId String?     @db.Uuid
  publishedAt       DateTime    @default(now())
  competition       Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  publishedBy       User?       @relation("StandingsPublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([competitionId, version])
  @@map("standings_publications")
}

// 已确认结果的更正被阻止（后续比赛已开始或已结束）时的人工处置登记。只追加，不修改比赛。
model ResultDisposition {
  id              String                    @id @default(uuid()) @db.Uuid
  matchId         String                    @db.Uuid
  decision        ResultDispositionDecision
  reason          String
  blockedBy       Json
  decidedByUserId String?                   @db.Uuid
  decidedAt       DateTime                  @default(now())
  match           Match                     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  decidedBy       User?                     @relation("ResultDispositionDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@map("result_dispositions")
}

// ---------------------------------------------------------------------------
// 阶段 7（prompt-kit 08）：成绩册、导出与公开查询
// ---------------------------------------------------------------------------

// 一次导出：文件字节与生成它的数据快照摘要一起保存，之后不可改写（触发器兜底）。
// 同一种正式版再次生成且数据已变化时，旧版标记「已被替代」但原文件保留。
model ReportExport {
  id                   String         @id @default(uuid()) @db.Uuid
  tournamentId         String         @db.Uuid
  kind                 ReportKind
  // 内部报名名单没有草稿/正式之分，为空。
  edition              ReportEdition?
  // 同一赛事同一种文件的顺序号。
  version              Int
  // 数据快照的内容摘要（SHA-256）：相同数据得到相同摘要，界面显示前 12 位作为「数据修订号」。
  snapshotHash         String
  // 快照在其一致性读取事务中的取数时刻。
  capturedAt           DateTime
  // 引用的名次榜单发布版本等出处（项目代码 → 版本）。
  sources              Json
  fileName             String
  contentType          String
  byteSize             Int
  sha256               String
  content              Bytes
  createdByUserId      String?        @db.Uuid
  createdAt            DateTime       @default(now())
  supersededAt         DateTime?
  supersededByExportId String?        @db.Uuid
  tournament           Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdBy            User?          @relation("ReportExportCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  // 迁移中把这个外键设为 DEFERRABLE INITIALLY DEFERRED（Prisma 无法表达）。
  supersededBy         ReportExport?  @relation("ReportExportSupersede", fields: [supersededByExportId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersedes           ReportExport[] @relation("ReportExportSupersede")

  @@unique([tournamentId, kind, version])
  @@index([tournamentId, createdAt])
  @@map("report_exports")
}
