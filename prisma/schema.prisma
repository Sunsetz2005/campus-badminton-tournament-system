generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// 平台级角色只决定「能否新建赛事」。赛事内的一切权限仍由赛事范围的 RoleAssignment 决定，
// SYSTEM_ADMIN 不会因此自动获得任何既有赛事的访问权。
enum SystemRole {
  USER
  SYSTEM_ADMIN
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// 发布可见性（TournamentStatus）与赛事生命周期（TournamentPhase）是两个维度，不得合并。
// phase 由组织者显式推进并审计，不按服务器当前时间推导。
enum TournamentPhase {
  PREPARING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  RUNNING
  FINISHED
}

// 参赛者姓名与代表队的公开范围由组织者决定，默认只公开编号。
enum NamePublicationPolicy {
  CODES_ONLY
  DISPLAY_NAMES
}

enum CompetitionKind {
  MS
  WS
  MD
  WD
  XD
  CUSTOM
}

enum EntryType {
  SINGLES
  DOUBLES
}

enum StageType {
  ROUND_ROBIN
  KNOCKOUT
}

enum TournamentRole {
  ADMIN
  ORGANIZER
  REFEREE
  CHIEF_REFEREE
}

// 报名只是「申请」；只有 APPROVED 才会生成 Entry，进入后续编排。
enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum RegistrationSource {
  MANUAL
  IMPORT
  INVITE
}

enum OfficialRole {
  MAIN_REFEREE
}

enum MatchLifecycleStatus {
  SCHEDULED
  READY
  IN_PROGRESS
  SUSPENDED
  ENDED_PENDING_SUBMISSION
  SUBMITTED
}

enum MatchOutcomeType {
  NORMAL
  WO
  RET
  DSQ
  ABANDONED
  BYE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  LOCKED
  DISPUTED
  SUPERSEDED
}

enum ScoringSessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ResultRevisionStatus {
  PENDING
  RETURNED
  LOCKED
  SUPERSEDED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  image               String?
  status              UserStatus           @default(ACTIVE)
  systemRole          SystemRole           @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  accounts            Account[]
  roleAssignments     RoleAssignment[]
  officialAssignments OfficialAssignment[]
  scoringSessions     ScoringSession[]
  matchEvents         MatchEvent[]         @relation("MatchEventActor")
  resultRevisions     ResultRevision[]     @relation("ResultRevisionActor")
  reviewedRevisions   ResultRevision[]     @relation("ResultRevisionReviewer")
  auditLogs           AuditLog[]           @relation("AuditActor")
  submittedRegistrations Registration[]    @relation("RegistrationSubmitter")
  reviewedRegistrations  Registration[]    @relation("RegistrationReviewer")
  createdInvites      RegistrationInvite[]
  importBatches       RegistrationImportBatch[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Tournament {
  id                    String                @id @default(uuid()) @db.Uuid
  slug                  String                @unique
  name                  String
  subtitle              String?
  organizer             String?
  venue                 String?
  summary               String?
  startDate             DateTime?             @db.Date
  endDate               DateTime?             @db.Date
  posterPath            String?
  posterAlt             String?
  timezone              String                @default("Asia/Shanghai")
  status                TournamentStatus      @default(DRAFT)
  phase                 TournamentPhase       @default(PREPARING)
  namePolicy            NamePublicationPolicy @default(CODES_ONLY)
  publishedAt           DateTime?
  regulations           String?
  registrationOpensAt   DateTime?
  registrationClosesAt  DateTime?
  nextParticipantSeq    Int                   @default(1)
  defaultRuleRevisionId String?               @db.Uuid
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  defaultRuleRevision   RuleProfileRevision? @relation("TournamentDefaultRule", fields: [defaultRuleRevisionId], references: [id], onDelete: SetNull)
  competitions          Competition[]
  courts                Court[]
  ruleProfiles          RuleProfile[]
  roleAssignments       RoleAssignment[]
  auditLogs             AuditLog[]
  participants          Participant[]
  registrations         Registration[]
  registrationInvites   RegistrationInvite[]
  importBatches         RegistrationImportBatch[]

  @@map("tournaments")
}

model Competition {
  id                    String               @id @default(uuid()) @db.Uuid
  tournamentId          String               @db.Uuid
  code                  String
  name                  String
  kind                  CompetitionKind
  entryType             EntryType
  ruleProfileRevisionId String?              @db.Uuid
  nextEntrySeq          Int                  @default(1)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  tournament            Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  ruleProfileRevision   RuleProfileRevision? @relation("CompetitionRule", fields: [ruleProfileRevisionId], references: [id], onDelete: SetNull)
  stages                Stage[]
  entries               Entry[]
  entryMembers          EntryMember[]
  registrations         Registration[]

  @@unique([tournamentId, code])
  @@index([tournamentId])
  @@map("competitions")
}

// 参赛人员按赛事隔离：同一个真实的人在两个赛事里是两条记录，互不泄露。
// 姓名不是身份；学号只在赛事内唯一，且与联系方式一样只供内部审核，不进入任何公开白名单。
model Participant {
  id                  String               @id @default(uuid()) @db.Uuid
  tournamentId        String               @db.Uuid
  publicCode          String
  displayName         String
  teamName            String?
  studentId           String?
  contact             String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tournament          Tournament           @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  memberships         EntryMember[]
  registrationMembers RegistrationMember[]

  @@unique([tournamentId, publicCode])
  @@unique([tournamentId, studentId])
  @@index([tournamentId, displayName])
  @@map("participants")
}

model Entry {
  id            String        @id @default(uuid()) @db.Uuid
  competitionId String        @db.Uuid
  code          String
  displayName   String
  entryType     EntryType
  frozenAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  competition   Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  members       EntryMember[]
  matchesAsA    Match[]       @relation("MatchSideA")
  matchesAsB    Match[]       @relation("MatchSideB")
  registration  Registration?

  @@unique([competitionId, code])
  @@index([competitionId])
  @@map("entries")
}

// competitionId 是 entries.competitionId 的冗余副本（由迁移中的触发器保证一致），
// 只为让数据库用唯一索引兜底「同一人在同一项目只能出现在一个报名单位里」。
model EntryMember {
  id            String      @id @default(uuid()) @db.Uuid
  entryId       String      @db.Uuid
  competitionId String      @db.Uuid
  participantId String      @db.Uuid
  slot          Int
  entry         Entry       @relation(fields: [entryId], references: [id], onDelete: Cascade)
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: NoAction)

  @@unique([entryId, participantId])
  @@unique([entryId, slot])
  @@unique([competitionId, participantId])
  @@index([participantId])
  @@map("entry_members")
}

model Registration {
  id                   String                   @id @default(uuid()) @db.Uuid
  tournamentId         String                   @db.Uuid
  competitionId        String                   @db.Uuid
  referenceCode        String                   @unique
  status               RegistrationStatus       @default(PENDING)
  source               RegistrationSource
  version              Int                      @default(0)
  dedupeKey            String?
  note                 String?
  reviewReason         String?
  entryId              String?                  @unique @db.Uuid
  inviteId             String?                  @db.Uuid
  importBatchId        String?                  @db.Uuid
  importRowNumber      Int?
  submittedByUserId    String?                  @db.Uuid
  submitterFingerprint String?
  reviewedByUserId     String?                  @db.Uuid
  reviewedAt           DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  tournament           Tournament               @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  competition          Competition              @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  // NoAction（语句末检查）：撤回时必须先解除关联再删 Entry；整赛事级联删除仍可在同一语句内完成。
  entry                Entry?                   @relation(fields: [entryId], references: [id], onDelete: NoAction)
  invite               RegistrationInvite?      @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  importBatch          RegistrationImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  submittedBy          User?                    @relation("RegistrationSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reviewedBy           User?                    @relation("RegistrationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  members              RegistrationMember[]

  @@index([tournamentId, status, createdAt])
  @@index([competitionId, status])
  @@index([inviteId, createdAt])
  @@map("registrations")
}

// 报名时提交的人员信息原样保留，便于审核留痕；审核通过时才解析为 Participant。
model RegistrationMember {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  slot           Int
  displayName    String
  studentId      String?
  teamName       String?
  contact        String?
  participantId  String?      @db.Uuid
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  participant    Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([registrationId, slot])
  @@index([participantId])
  @@map("registration_members")
}

// 匿名邀请链接：只保存令牌摘要，明文令牌仅在创建时返回一次。
model RegistrationInvite {
  id              String         @id @default(uuid()) @db.Uuid
  tournamentId    String         @db.Uuid
  label           String
  tokenHash       String         @unique
  tokenHint       String
  expiresAt       DateTime
  maxSubmissions  Int
  submissionCount Int            @default(0)
  revokedAt       DateTime?
  createdByUserId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tournament      Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  registrations   Registration[]

  @@index([tournamentId])
  @@map("registration_invites")
}

// 导入批次只记录内容摘要与计数，不保存上传原文件。
model RegistrationImportBatch {
  id              String         @id @default(uuid()) @db.Uuid
  tournamentId    String         @db.Uuid
  contentHash     String
  rowCount        Int
  createdCount    Int
  skippedCount    Int
  createdByUserId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  tournament      Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  registrations   Registration[]

  @@unique([tournamentId, contentHash])
  @@map("registration_import_batches")
}

model Stage {
  id                    String               @id @default(uuid()) @db.Uuid
  competitionId         String               @db.Uuid
  code                  String
  name                  String
  type                  StageType
  order                 Int
  ruleProfileRevisionId String?              @db.Uuid
  frozenAt              DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  competition           Competition          @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  ruleProfileRevision   RuleProfileRevision? @relation("StageRule", fields: [ruleProfileRevisionId], references: [id], onDelete: SetNull)
  groups                Group[]
  matches               Match[]

  @@unique([competitionId, code])
  @@map("stages")
}

model Group {
  id        String   @id @default(uuid()) @db.Uuid
  stageId   String   @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stage     Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  matches   Match[]

  @@unique([stageId, code])
  @@map("competition_groups")
}

model Court {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @db.Uuid
  code         String
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches      Match[]

  @@unique([tournamentId, code])
  @@map("courts")
}

model RuleProfile {
  id           String                @id @default(uuid()) @db.Uuid
  tournamentId String                @db.Uuid
  key          String
  name         String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tournament   Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  revisions    RuleProfileRevision[]

  @@unique([tournamentId, key])
  @@map("rule_profiles")
}

model RuleProfileRevision {
  id                    String              @id @default(uuid()) @db.Uuid
  ruleProfileId         String              @db.Uuid
  revision              Int
  sourceLabel           String
  sourceVersion         String
  config                Json
  configHash            String
  effectiveFrom         DateTime?
  adoptedAt             DateTime?
  frozenAt              DateTime?
  createdAt             DateTime            @default(now())
  ruleProfile           RuleProfile         @relation(fields: [ruleProfileId], references: [id], onDelete: Restrict)
  defaultForTournaments Tournament[]        @relation("TournamentDefaultRule")
  competitions          Competition[]       @relation("CompetitionRule")
  stages                Stage[]             @relation("StageRule")
  matchSnapshots        MatchRuleSnapshot[]

  @@unique([ruleProfileId, revision])
  @@map("rule_profile_revisions")
}

model Match {
  id                  String               @id @default(uuid()) @db.Uuid
  code                String               @unique
  stageId             String               @db.Uuid
  groupId             String?              @db.Uuid
  courtId             String?              @db.Uuid
  sideAEntryId        String?              @db.Uuid
  sideBEntryId        String?              @db.Uuid
  lifecycleStatus     MatchLifecycleStatus @default(SCHEDULED)
  outcomeType         MatchOutcomeType?
  verificationStatus  VerificationStatus   @default(UNVERIFIED)
  scheduledAt         DateTime?
  startedAt           DateTime?
  endedAt             DateTime?
  publishedAt         DateTime?
  version             Int                  @default(0)
  controlGeneration   Int                  @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  stage               Stage                @relation(fields: [stageId], references: [id], onDelete: Restrict)
  group               Group?               @relation(fields: [groupId], references: [id], onDelete: SetNull)
  court               Court?               @relation(fields: [courtId], references: [id], onDelete: SetNull)
  sideAEntry          Entry?               @relation("MatchSideA", fields: [sideAEntryId], references: [id], onDelete: Restrict)
  sideBEntry          Entry?               @relation("MatchSideB", fields: [sideBEntryId], references: [id], onDelete: Restrict)
  games               Game[]
  ruleSnapshot        MatchRuleSnapshot?
  events              MatchEvent[]
  snapshot            MatchSnapshot?
  scoringSessions     ScoringSession[]
  resultRevisions     ResultRevision[]
  officialAssignments OfficialAssignment[]

  @@index([stageId])
  @@index([courtId, scheduledAt])
  @@index([publishedAt, scheduledAt])
  @@map("matches")
}

model MatchRuleSnapshot {
  id                    String              @id @default(uuid()) @db.Uuid
  matchId               String              @unique @db.Uuid
  ruleProfileRevisionId String              @db.Uuid
  config                Json
  configHash            String
  sourceChain           Json
  createdAt             DateTime            @default(now())
  match                 Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  ruleProfileRevision   RuleProfileRevision @relation(fields: [ruleProfileRevisionId], references: [id], onDelete: Restrict)

  @@map("match_rule_snapshots")
}

model Game {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @db.Uuid
  number    Int
  scoreA    Int      @default(0)
  scoreB    Int      @default(0)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, number])
  @@map("games")
}

model MatchEvent {
  id                 String          @id @default(uuid()) @db.Uuid
  matchId            String          @db.Uuid
  version            Int
  commandId          String?         @unique @db.Uuid
  domainEventId      String?
  expectedVersion    Int?
  commandFingerprint String?
  type               String
  payload            Json
  stateBefore        Json?
  stateAfter         Json?
  stateBeforeHash    String?
  stateAfterHash     String?
  metadata           Json?
  response           Json?
  engineVersion      Int             @default(1)
  actorUserId        String?         @db.Uuid
  actorRole          TournamentRole?
  scoringSessionId   String?         @db.Uuid
  occurredAt         DateTime        @default(now())
  match              Match           @relation(fields: [matchId], references: [id], onDelete: Restrict)
  actor              User?           @relation("MatchEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  scoringSession     ScoringSession? @relation(fields: [scoringSessionId], references: [id], onDelete: SetNull)

  @@unique([matchId, version])
  @@index([scoringSessionId])
  @@map("match_events")
}

model MatchSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  matchId          String   @unique @db.Uuid
  version          Int      @default(0)
  engineVersion    Int      @default(1)
  initialState     Json
  initialStateHash String
  state            Json
  stateHash        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("match_snapshots")
}

model ScoringSession {
  id                 String               @id @default(uuid()) @db.Uuid
  matchId            String               @db.Uuid
  userId             String               @db.Uuid
  deviceSessionId    String
  tokenHash          String               @unique
  takeoverGeneration Int                  @default(1)
  actingRole         TournamentRole       @default(REFEREE)
  status             ScoringSessionStatus @default(ACTIVE)
  expiresAt          DateTime
  lastHeartbeatAt    DateTime             @default(now())
  revokedAt          DateTime?
  revokedReason      String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  match              Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  matchEvents        MatchEvent[]

  @@index([matchId, status])
  @@map("scoring_sessions")
}

model ResultRevision {
  id               String               @id @default(uuid()) @db.Uuid
  matchId          String               @db.Uuid
  revision         Int
  status           ResultRevisionStatus @default(PENDING)
  result           Json
  reason           String?
  actorUserId      String?              @db.Uuid
  submittedRole    TournamentRole?
  reviewedByUserId String?              @db.Uuid
  reviewedRole     TournamentRole?
  reviewedAt       DateTime?
  returnedAt       DateTime?
  createdAt        DateTime             @default(now())
  match            Match                @relation(fields: [matchId], references: [id], onDelete: Restrict)
  actor            User?                @relation("ResultRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  reviewedBy       User?                @relation("ResultRevisionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([matchId, revision])
  @@index([reviewedByUserId])
  @@map("result_revisions")
}

model RoleAssignment {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  tournamentId String         @db.Uuid
  role         TournamentRole
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament   Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId, role])
  @@index([tournamentId, role])
  @@map("role_assignments")
}

model OfficialAssignment {
  id        String       @id @default(uuid()) @db.Uuid
  matchId   String       @db.Uuid
  userId    String       @db.Uuid
  role      OfficialRole @default(MAIN_REFEREE)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  match     Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId, role])
  @@index([userId, active])
  @@map("official_assignments")
}

model AuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  tournamentId String?     @db.Uuid
  actorUserId  String?     @db.Uuid
  action       String
  targetType   String
  targetId     String
  outcome      String
  metadata     Json?
  occurredAt   DateTime    @default(now())
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  actor        User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tournamentId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_logs")
}
