# 复制为 .env.test，只允许指向以 _test 结尾的本机测试库。
DATABASE_URL="postgresql://YOUR_LOCAL_USER@localhost:5432/badminton_tournament_test?schema=public"
BETTER_AUTH_SECRET="请替换为至少32字符的测试随机值"
BETTER_AUTH_URL="http://127.0.0.1:3100"
APP_ENV="test"

# 该开关只授权本地种子创建模拟身份，不会开放网页公众注册。
ALLOW_DEMO_ACCOUNTS="true"
ENABLE_TEST_FAULT_INJECTION="true"
ENABLE_PUBLIC_UI_PREVIEW="true"
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
DEMO_REFEREE_EMAIL=""
DEMO_REFEREE_PASSWORD=""
