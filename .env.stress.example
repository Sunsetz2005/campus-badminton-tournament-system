# 全赛制并发仿真（scripts/stress/）专用。复制为 .env.stress；库名必须以 _test 结尾（assertTestDatabaseUrl）。
# 不要指向开发库、演示库或其他项目的数据库。
DATABASE_URL="postgresql://YOUR_LOCAL_USER@localhost:5432/badminton_tournament_stress_test?schema=public"
BETTER_AUTH_SECRET="请替换为至少32字符的测试随机值"
# 仿真自己以生产模式 next start 到这个端口。
BETTER_AUTH_URL="http://127.0.0.1:3200"
APP_ENV="test"

# 只供 stress:prepare 的种子创建管理员与平台共用裁判账号；仿真起服务时会去掉这些变量。
ALLOW_DEMO_ACCOUNTS="true"
DEMO_ADMIN_EMAIL=""
DEMO_ADMIN_PASSWORD=""
DEMO_REFEREE_EMAIL=""
DEMO_REFEREE_PASSWORD=""

# 公开接口每来源每分钟额度；留空用默认 600。主运行可调高以区分「限流」与「系统错误」。
PUBLIC_RATE_LIMIT_PER_MINUTE=""
